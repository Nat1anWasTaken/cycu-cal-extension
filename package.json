{
  "name": "cycu-cal-extension",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs --watch",
    "package": "node scripts/build.mjs --zip",
    "package:offline-0.5b": "node scripts/build.mjs --zip --offline=qwen2.5-coder-0.5b",
    "package:offline-1.5b": "node scripts/build.mjs --zip --offline=qwen2.5-coder-1.5b",
    "fetch-vendor": "node scripts/fetch-vendor.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test src/**/__tests__/*.test.ts"
  },
  "dependencies": {
    "@wllama/wllama": "^3.8.1",
    "monaco-editor": "^0.57.0",
    "vscode-languageserver-protocol": "^3.18.4"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.5",
    "@types/node": "^26.6.5",
    "ace-builds": "^1.44.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  },
  "packageManager": "pnpm@12.11.2"
}
